# =============================================================================
# mobileapptcc_frontend — copy to .env and pick ONE block
# Restart Expo after changes: npx expo start -c
#
# CRITICAL: On a REAL PHONE, never use 127.0.0.1 — that is the phone itself.
# Use your PC Wi‑Fi IPv4 (ipconfig). Phone + PC must be on the same Wi‑Fi.
# BOTH API URLs must include http:// or https:// and usually match for local LAN.
# Proctor login uses EXPO_PUBLIC_CLOUD_API_URL (falls back to EXPO_PUBLIC_API_URL).
# =============================================================================

# --- LOCAL · Expo web / emulator on same PC ---
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
EXPO_PUBLIC_CLOUD_API_URL=http://127.0.0.1:8000/api/v1
EXPO_PUBLIC_SYNC_TOKEN=metcc-lan-sync-secret

# --- LOCAL · physical phone on same Wi‑Fi ---
# EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:8000/api/v1
# EXPO_PUBLIC_CLOUD_API_URL=http://YOUR_LAN_IP:8000/api/v1
# EXPO_PUBLIC_SYNC_TOKEN=metcc-lan-sync-secret

# --- DEPLOY / cloud ---
# EXPO_PUBLIC_API_URL=https://metccapi.repohive.com/api/v1
# EXPO_PUBLIC_CLOUD_API_URL=https://metccapi.repohive.com/api/v1
# EXPO_PUBLIC_SYNC_TOKEN=metcc-lan-sync-secret
