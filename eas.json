{
  "cli": {
    "version": ">= 18.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.masterexam.pro/api/v1",
        "EXPO_PUBLIC_CLOUD_API_URL": "https://api.masterexam.pro/api/v1"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.masterexam.pro/api/v1",
        "EXPO_PUBLIC_CLOUD_API_URL": "https://api.masterexam.pro/api/v1"
      },
      "channel": "preview"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "distribution": "store"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.masterexam.pro/api/v1",
        "EXPO_PUBLIC_CLOUD_API_URL": "https://api.masterexam.pro/api/v1"
      }
    },
    "production-store": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.masterexam.pro/api/v1",
        "EXPO_PUBLIC_CLOUD_API_URL": "https://api.masterexam.pro/api/v1"
      },
      "channel": "production-store"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appName": "MasterExam – TCC",
        "bundleIdentifier": "edu.tcc.entranceexam"
      }
    }
  }
}
