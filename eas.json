{
  "cli": {
    "version": ">= 18.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://metccapi.repohive.com/api/v1",
        "EXPO_PUBLIC_CLOUD_API_URL": "https://metccapi.repohive.com/api/v1",
        "EXPO_PUBLIC_SYNC_TOKEN": "metcc-lan-sync-secret"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://metccapi.repohive.com/api/v1",
        "EXPO_PUBLIC_CLOUD_API_URL": "https://metccapi.repohive.com/api/v1",
        "EXPO_PUBLIC_SYNC_TOKEN": "metcc-lan-sync-secret"
      },
      "channel": "preview"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://metccapi.repohive.com/api/v1",
        "EXPO_PUBLIC_CLOUD_API_URL": "https://metccapi.repohive.com/api/v1",
        "EXPO_PUBLIC_SYNC_TOKEN": "metcc-lan-sync-secret"
      }
    },
    "production-store": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://metccapi.repohive.com/api/v1",
        "EXPO_PUBLIC_CLOUD_API_URL": "https://metccapi.repohive.com/api/v1",
        "EXPO_PUBLIC_SYNC_TOKEN": "metcc-lan-sync-secret"
      },
      "channel": "production-store"
    }
  },
  "submit": {
    "production": {}
  }
}
