# =============================================================================
# mobileapptcc_frontend — API URLs
# Keep ONE block active. EXPO_PUBLIC_* values are baked into EAS Update bundles.
# After changing this file, republish: eas update --branch production
# Demo proctor: proctor@example.com / password
# =============================================================================

# --- DEPLOY / cloud (ACTIVE — required for phone login after OTA) ---
EXPO_PUBLIC_API_URL=https://api.masterexam.pro/api
EXPO_PUBLIC_CLOUD_API_URL=https://api.masterexam.pro/api
EXPO_PUBLIC_SYNC_TOKEN=metcc-lan-sync-secret

# --- LOCAL · Expo web / emulator on same PC ---
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# EXPO_PUBLIC_CLOUD_API_URL=http://127.0.0.1:8000/api/v1
# EXPO_PUBLIC_SYNC_TOKEN=metcc-lan-sync-secret

# --- LOCAL · physical phone on same Wi‑Fi ---
# EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:8000/api/v1
# EXPO_PUBLIC_CLOUD_API_URL=http://YOUR_LAN_IP:8000/api/v1
# EXPO_PUBLIC_SYNC_TOKEN=metcc-lan-sync-secret
