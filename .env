# =============================================================================
# mobileapptcc_frontend — API URLs
# Uncomment ONE block only. Restart Expo after changes: npx expo start -c
# Demo proctor: proctor@example.com / password
#
# CRITICAL: On a REAL PHONE, never use 127.0.0.1 — that is the phone itself.
# Use your PC Wi‑Fi IPv4 (ipconfig → Wireless LAN adapter Wi‑Fi → IPv4).
# Phone + PC must be on the SAME Wi‑Fi.
#
# BOTH URLs must match for local LAN testing. Different IPs (e.g. 192.168.x
# vs 10.x) cause pack download / Wi‑Fi mismatch failures.
# Serve Laravel with: php artisan serve --host=0.0.0.0 --port=8000
#
# Peer / offline exams: students talk to the PROCTOR PHONE (from the QR),
# not these URLs. These URLs are only for pack download + online mode.
# =============================================================================

# --- LOCAL · Expo web / emulator on same PC ---
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# EXPO_PUBLIC_CLOUD_API_URL=http://127.0.0.1:8000/api/v1
# EXPO_PUBLIC_SYNC_TOKEN=metcc-lan-sync-secret

# --- LOCAL · physical phone on same Wi‑Fi (ACTIVE) ---
# Update BOTH whenever ipconfig changes.
# EXPO_PUBLIC_API_URL=http://192.168.1.25:8000/api/v1
# EXPO_PUBLIC_CLOUD_API_URL=http://192.168.1.25:8000/api/v1
# EXPO_PUBLIC_SYNC_TOKEN=metcc-lan-sync-secret

# --- DEPLOY / cloud ---
EXPO_PUBLIC_API_URL=https://metccapi.repohive.com/api/v1
EXPO_PUBLIC_CLOUD_API_URL=https://metccapi.repohive.com/api/v1
EXPO_PUBLIC_SYNC_TOKEN=metcc-lan-sync-secret
