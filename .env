# =============================================================================
# mobileapptcc_frontend — API URLs
# Switch mode: uncomment ONE block, comment the other. Then restart Expo.
# Local login uses your local Laravel DB (php artisan serve + db:seed).
# Demo proctor: proctor@example.com / password
# =============================================================================

# --- LOCAL (active) — local database / php artisan serve --host=0.0.0.0 --port=8000 ---
# Expo web / same PC:
#EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
#EXPO_PUBLIC_CLOUD_API_URL=http://127.0.0.1:8000/api/v1
# Physical phone on same Wi‑Fi (update IP via ipconfig if it changes):
# EXPO_PUBLIC_API_URL=http://10.209.21.42:8000/api/v1
# EXPO_PUBLIC_CLOUD_API_URL=http://10.209.21.42:8000/api/v1
#EXPO_PUBLIC_SYNC_TOKEN=metcc-lan-sync-secret

# --- DEPLOY / cloud (comment LOCAL above, uncomment below) ---
EXPO_PUBLIC_API_URL=https://metccapi.repohive.com/api/v1
EXPO_PUBLIC_CLOUD_API_URL=https://metccapi.repohive.com/api/v1
EXPO_PUBLIC_SYNC_TOKEN=metcc-lan-sync-secret
